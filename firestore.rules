rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeTrainer() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function assigned(clientId) {
      return activeTrainer()
        && request.auth.uid in get(/databases/$(database)/documents/clients/$(clientId)).data.assignedTrainerIds;
    }
    function assignedClientResource() {
      // A collection query must be provable from each prospective document.
      return activeTrainer()
        && request.auth.uid in resource.data.assignedTrainerIds;
    }

    // Profiles are provisioned by trusted administration only.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, delete: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone']);
    }

    match /clients/{clientId} {
      allow get: if assigned(clientId);
      allow list: if assignedClientResource();
      // Active trainer may create a client assigned to themselves
      allow create: if activeTrainer()
        && request.auth.uid in request.resource.data.assignedTrainerIds;
      // Assigned trainer may update client data, but cannot alter assignedTrainerIds
      allow update: if assigned(clientId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedTrainerIds']);
      allow delete: if assigned(clientId);
    }
    match /clients/{clientId}/{subcollection}/{documentId} {
      allow read, write: if assigned(clientId);
    }
    match /pt_packages/{packageId} {
      allow read, write: if false;
    }
    match /workout_logs/{logId} {
      allow read, write: if false;
    }
    match /exercise_catalog/{exerciseId} {
      allow read: if activeTrainer();
      allow write: if false;
    }
  }
}
